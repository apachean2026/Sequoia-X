.github
  └── workflows
      └── sequoia-x.yml
name: Sequoia-X 每日选股

on:
  workflow_dispatch:
  schedule:
    # 每个工作日北京时间 19:30
    # GitHub Actions 使用 UTC，所以北京时间减 8 小时
    - cron: "30 11 * * 1-5"

permissions:
  contents: read

jobs:
  run-sequoia:
    runs-on: ubuntu-latest

    steps:
      # 1. 下载代码
      - name: Checkout
        uses: actions/checkout@v4

      # 2. 安装 Python
      - name: Setup Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.11"

      # 3. 安装 uv
      - name: Install uv
        uses: astral-sh/setup-uv@v6
        with:
          enable-cache: true

      # 4. 安装项目依赖
      - name: Install dependencies
        run: uv sync

      # 5. 创建 .env
      - name: Create environment file
        run: |
          cat > .env << EOF
          FEISHU_WEBHOOK_URL=${{ secrets.FEISHU_WEBHOOK_URL }}
          EOF

      # 6. 运行 Sequoia-X
      - name: Run Sequoia-X
        run: |
          uv run python main.py

      # 7. 保存数据库和日志
      - name: Upload database and logs
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: sequoia-x-data-${{ github.run_number }}
          path: |
            data/
            *.log
          if-no-files-found: ignore
          retention-days: 7
